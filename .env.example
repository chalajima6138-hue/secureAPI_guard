# Copy to .env and export these (the app reads process.env; it does not load .env files itself).
NODE_ENV=development
HOST=127.0.0.1            # loopback by default. Change deliberately, and only behind TLS.
PORT=3000
DB_PATH=./data/secureapi-guard.db
COOKIE_SECURE=false       # must be true in production (HTTPS)
TRUST_PROXY=false         # true when behind a TLS-terminating reverse proxy
ALLOW_PRIVATE_UPSTREAMS=false   # true ONLY for local testing with loopback/LAN backends. Must be false in production.
ALLOW_HTTP_UPSTREAMS=true       # must be false in production
UPSTREAM_TIMEOUT_MS=10000
MAX_APIS_PER_CUSTOMER=10
AUTH_RATE_LIMIT=10        # login/register attempts per IP per minute
API_RATE_LIMIT=300        # dashboard API calls per IP per minute
GATEWAY_RATE_LIMIT=600    # gateway requests per minute (per IP before auth, per API after)
LOG_REQUESTS=false        # JSON request log lines to stdout (on by default in production)
SESSION_DAYS=7
